{
  "name": "fullstackpath",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "content:parse": "node scripts/parse-roadmap.mjs",
    "content:outline": "node scripts/generate-outline.mjs",
    "content:coverage": "tsx scripts/coverage.mjs",
    "content:test": "node scripts/test-parse-section.mjs",
    "content:sync": "npm run content:parse && npm run content:outline && npm run db:generate && npm run db:seed && npm run content:coverage",
    "verify": "npm run typecheck && npm run lint && npm run build",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
